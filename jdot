#!/usr/bin/env node
/**
 * jdot - small maintenance CLI for this dotfiles repo.
 *
 * Commands:
 *   jdot stow                          Stow every package (skips names in .jdotignore)
 *   jdot unstow [pkg]                   Unstow one package, or everything if omitted
 *   jdot alias                          Regenerate shell aliases + Finder aliases from folders.toml
 *   jdot doctor                         Report broken symlinks under $HOME
 *   jdot benchmark-shell [-r N] [-v]    Benchmark zsh startup time
 *   jdot digest                         Regenerate DOTFILES.md digest of this repo (never touches AGENTS.md)
 *   jdot pi-digest                      Regenerate pi/PI.md (skills/extensions/packages digest)
 *
 * Not a general-purpose tool: it only knows about this repo's layout.
 */

"use strict";

const fs = require("fs");
const path = require("path");
const os = require("os");
const { pathToFileURL } = require("url");
const { execFileSync, execSync } = require("child_process");

const REPO_ROOT = __dirname;
// Stow packages live under home/ (stow dir); repo-root files (folders.toml,
// .jdotignore, DOTFILES.md) stay at REPO_ROOT.
const PKG_ROOT = path.join(REPO_ROOT, "home");
const HOME = os.homedir();

function expandHome(p) {
  if (p === "~") return HOME;
  if (p.startsWith("~/")) return path.join(HOME, p.slice(2));
  return p;
}

// --- minimal TOML subset parser -------------------------------------------
// Supports: [table], [table.sub], [table."quoted key"], key = "string",
// key = true/false. Enough for folders.toml, nothing more.
function parseToml(text) {
  const root = {};
  let current = root;
  const lines = text.split("\n");
  for (let raw of lines) {
    const line = raw.replace(/#.*$/, "").trim();
    if (!line) continue;
    const tableMatch = line.match(/^\[([^\]]+)\]$/);
    if (tableMatch) {
      const parts = tableMatch[1]
        .split(".")
        .map((p) => p.trim().replace(/^"(.*)"$/, "$1"));
      current = root;
      for (const part of parts) {
        if (!current[part] || typeof current[part] !== "object") {
          current[part] = {};
        }
        current = current[part];
      }
      continue;
    }
    const kvMatch = line.match(/^"?([^"=]+?)"?\s*=\s*(.+)$/);
    if (kvMatch) {
      const key = kvMatch[1].trim();
      let value = kvMatch[2].trim();
      if (value === "true") value = true;
      else if (value === "false") value = false;
      else if (/^".*"$/.test(value)) value = value.slice(1, -1);
      current[key] = value;
    }
  }
  return root;
}

// --- .jdotignore -------------------------------------------------------
function readIgnore() {
  const file = path.join(REPO_ROOT, ".jdotignore");
  if (!fs.existsSync(file)) return { packages: [], globs: [] };
  const lines = fs
    .readFileSync(file, "utf8")
    .split("\n")
    .map((l) => l.replace(/#.*$/, "").trim())
    .filter(Boolean);
  const packages = lines.filter((l) => !l.includes("/") && !l.includes("*"));
  const globs = lines.filter((l) => l.includes("/") || l.includes("*"));
  return { packages, globs };
}

function listPackages() {
  return fs
    .readdirSync(PKG_ROOT, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name)
    .filter((name) => !name.startsWith(".") && name !== "packages" && name !== "node_modules");
}

// --- commands ------------------------------------------------------------
function cmdStow() {
  const { packages: ignored } = readIgnore();
  const all = listPackages();
  const toStow = all.filter((p) => !ignored.includes(p));
  if (ignored.length) {
    console.log(`Skipping (in .jdotignore): ${ignored.join(", ")}`);
  }
  if (!toStow.length) {
    console.log("Nothing to stow.");
    return;
  }
  execFileSync("stow", ["-t", HOME, ...toStow], { cwd: PKG_ROOT, stdio: "inherit" });
  console.log(`Stowed: ${toStow.join(", ")}`);
}

function cmdUnstow(pkg) {
  const targets = pkg ? [pkg] : listPackages();
  execFileSync("stow", ["-D", "-t", HOME, ...targets], { cwd: PKG_ROOT, stdio: "inherit" });
  console.log(`Unstowed: ${targets.join(", ")}`);
}

function cmdAlias() {
  const tomlPath = path.join(REPO_ROOT, "folders.toml");
  if (!fs.existsSync(tomlPath)) {
    console.error("No folders.toml found.");
    process.exit(1);
  }
  const config = parseToml(fs.readFileSync(tomlPath, "utf8"));

  const shLines = ["# Generated by `jdot alias` from folders.toml. Do not edit by hand.", ""];

  for (const [name, entry] of Object.entries(config.folders || {})) {
    if (!entry.path) continue;
    shLines.push(`alias ${name}="cd ${entry.path.replace(/"/g, '\\"')}"`);
  }
  for (const [name, entry] of Object.entries(config.commands || {})) {
    if (entry.cd && entry.run) {
      shLines.push(`alias '${name}'="cd ${entry.cd} && ${entry.run}"`);
    } else if (entry.path) {
      shLines.push(`alias '${name}'="cd ${entry.path}"`);
    }
  }

  const outDir = path.join(HOME, ".config", "jdot");
  fs.mkdirSync(outDir, { recursive: true });
  const outFile = path.join(outDir, "aliases.zsh");
  fs.writeFileSync(outFile, shLines.join("\n") + "\n");
  console.log(`Wrote ${outFile}`);

  // Finder aliases
  for (const [name, entry] of Object.entries(config.folders || {})) {
    if (!entry.finder) continue;
    const target = expandHome(entry.path);
    const finderDir = expandHome(entry.finder_dir || "~/Documents/GitHub");
    const aliasPath = path.join(finderDir, name);
    if (fs.existsSync(aliasPath)) {
      console.log(`Finder alias already exists: ${aliasPath}`);
      continue;
    }
    if (!fs.existsSync(target)) {
      console.log(`Skipping Finder alias for ${name}: target ${target} does not exist`);
      continue;
    }
    const script = `
      set targetItem to POSIX file "${target}" as alias
      set aliasFolder to POSIX file "${finderDir}" as alias
      tell application "Finder"
        make new alias file to targetItem at aliasFolder
        set name of result to "${name}"
      end tell
    `;
    try {
      execSync(`osascript -e '${script.replace(/'/g, "'\\''")}'`);
      console.log(`Created Finder alias: ${aliasPath}`);
    } catch (err) {
      console.error(`Failed to create Finder alias for ${name}: ${err.message}`);
    }
  }
}

function readPackageIgnore(pkgDir) {
  const patterns = [];
  for (const file of [path.join(PKG_ROOT, ".stow-local-ignore"), path.join(pkgDir, ".stow-local-ignore")]) {
    if (!fs.existsSync(file)) continue;
    for (const line of fs.readFileSync(file, "utf8").split("\n")) {
      const trimmed = line.trim();
      if (trimmed) patterns.push(new RegExp(trimmed));
    }
  }
  return patterns;
}

function cmdDoctor() {
  const packages = listPackages();
  let broken = 0;
  for (const pkg of packages) {
    const pkgDir = path.join(PKG_ROOT, pkg);
    const ignorePatterns = readPackageIgnore(pkgDir);
    walk(pkgDir, pkgDir, ignorePatterns);
  }
  function walk(dir, pkgRoot, ignorePatterns) {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      if (entry.name.startsWith(".")) continue;
      const full = path.join(dir, entry.name);
      const relToPkg = "/" + path.relative(pkgRoot, full);
      if (ignorePatterns.some((re) => re.test(relToPkg) || re.test(entry.name))) continue;
      if (entry.isDirectory()) {
        walk(full, pkgRoot, ignorePatterns);
        continue;
      }
      const rel = path.relative(pkgRoot, full);
      const targetPath = path.join(HOME, rel.split(path.sep).slice(0).join(path.sep));
      // strip package name's own root segment mapping: package dir maps to $HOME root
      const homeTarget = path.join(HOME, path.relative(pkgRoot, full));
      if (!fs.existsSync(homeTarget)) {
        console.log(`MISSING  ${homeTarget}`);
        broken++;
        continue;
      }
      const stat = fs.lstatSync(homeTarget);
      if (stat.isSymbolicLink()) {
        const real = fs.realpathSync(homeTarget);
        if (real !== fs.realpathSync(full)) {
          console.log(`WRONG    ${homeTarget} -> ${real}`);
          broken++;
        }
      }
    }
  }
  if (broken === 0) {
    console.log("No broken symlinks found.");
  } else {
    console.log(`${broken} issue(s) found.`);
  }
}

function cmdBenchmarkShell(args) {
  let runs = 10;
  let verbose = false;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "-r") runs = parseInt(args[++i], 10) || runs;
    else if (args[i] === "-v") verbose = true;
  }

  const times = [];
  for (let i = 0; i < runs; i++) {
    const start = process.hrtime.bigint();
    execFileSync("zsh", ["-i", "-c", "exit"], { stdio: "ignore" });
    const elapsedMs = Number(process.hrtime.bigint() - start) / 1e6;
    times.push(elapsedMs);
    if (verbose) console.log(`  run ${i + 1}: ${(elapsedMs / 1000).toFixed(3)}s`);
  }

  const avg = times.reduce((a, b) => a + b, 0) / times.length;
  const min = Math.min(...times);
  const max = Math.max(...times);

  console.log("");
  console.log("zsh Shell Startup Benchmark");
  console.log(`  Runs: ${runs}`);
  console.log(`  Average: ${(avg / 1000).toFixed(3)}s`);
  console.log(`  Fastest: ${(min / 1000).toFixed(3)}s`);
  console.log(`  Slowest: ${(max / 1000).toFixed(3)}s`);
  console.log(`  Range:   ${((max - min) / 1000).toFixed(3)}s`);

  if (avg <= 100) console.log("  ✓ Excellent startup performance (≤100ms)");
  else if (avg <= 200) console.log("  ✓ Good startup performance (≤200ms)");
  else if (avg <= 400) console.log("  ⚠ Fair startup performance (≤400ms)");
  else console.log("  ⚠ Slow startup — consider profiling with `zsh -xvi -c exit`");
}

function cmdAgents() {
  const packages = listPackages();
  const { packages: ignored } = readIgnore();

  const tomlPath = path.join(REPO_ROOT, "folders.toml");
  let folderNames = [];
  if (fs.existsSync(tomlPath)) {
    const config = parseToml(fs.readFileSync(tomlPath, "utf8"));
    folderNames = Object.keys(config.folders || {});
  }

  let commit = "unknown";
  try {
    commit = execSync("git rev-parse --short HEAD", { cwd: REPO_ROOT }).toString().trim();
  } catch {}

  const lines = [];
  lines.push("# DOTFILES");
  lines.push("");
  lines.push(`**Generated:** ${new Date().toISOString()}`);
  lines.push(`**Commit:** ${commit}`);
  lines.push("");
  lines.push("macOS dev env via GNU Stow, managed by `jdot`.");
  lines.push("");
  lines.push("## STRUCTURE");
  lines.push("");
  lines.push("```");
  lines.push("dotfiles/");
  lines.push("├── jdot");
  lines.push("├── folders.toml         # Folder jump aliases + Finder aliases");
  lines.push("├── .jdotignore          # Machine-local package opt-outs (gitignored)");
  lines.push("├── home/");
  for (const [index, pkg] of packages.sort().entries()) {
    const skipped = ignored.includes(pkg) ? "  (skipped by .jdotignore on this machine)" : "";
    lines.push(`│   ${index === packages.length - 1 ? "└──" : "├──"} ${pkg}/${skipped}`);
  }
  lines.push("└── packages/bundle     # Brewfile");
  lines.push("```");
  lines.push("");
  lines.push("## COMMANDS");
  lines.push("");
  lines.push("```bash");
  lines.push("jdot stow              # Stow all packages (skips .jdotignore entries)");
  lines.push("jdot unstow [pkg]      # Unstow one package, or everything");
  lines.push("jdot alias             # Regenerate shell + Finder aliases from folders.toml");
  lines.push("jdot doctor            # Find broken symlinks under $HOME");
  lines.push("jdot benchmark-shell   # zsh startup perf (-r N runs, -v verbose)");
  lines.push("jdot digest             # Regenerate this file");
  lines.push("jdot pi-digest          # Regenerate home/pi/PI.md");
  lines.push("jdot skills-check       # Validate repository skills without changes");
  lines.push("```");
  lines.push("");
  if (folderNames.length) {
    lines.push("## FOLDER ALIASES");
    lines.push("");
    lines.push(folderNames.map((n) => `\`${n}\``).join(", "));
    lines.push("");
  }
  lines.push("## ANTI-PATTERNS");
  lines.push("");
  lines.push("- Edit an unstowed local copy and expect it to update this repository; verify the symlink target first");
  lines.push("- Hand-edit `~/.config/jdot/aliases.zsh` (regenerated by `jdot alias`, not tracked)");
  lines.push("- Hardcode paths (use `$HOME`, not `/Users/justin`)");
  lines.push("- Commit `.jdotignore` (machine-local; edit `.jdotignore.example` for shared defaults)");
  lines.push("");

  const outPath = path.join(REPO_ROOT, "DOTFILES.md");
  fs.writeFileSync(outPath, lines.join("\n"));
  console.log(`Wrote ${outPath}`);
}

async function cmdPiDigest() {
  const piAgentDir = path.join(PKG_ROOT, "pi", ".pi", "agent");
  if (!fs.existsSync(piAgentDir)) {
    console.error(`No pi/.pi/agent found under ${PKG_ROOT} yet. Run this after the pi package is merged in.`);
    process.exit(1);
  }

  const settingsPath = path.join(piAgentDir, "settings.json");
  let packages = [];
  if (fs.existsSync(settingsPath)) {
    try {
      packages = JSON.parse(fs.readFileSync(settingsPath, "utf8")).packages || [];
    } catch {}
  }

  const { skills } = await loadRepositorySkills();
  const extensions = fs.existsSync(path.join(piAgentDir, "extensions"))
    ? fs
        .readdirSync(path.join(piAgentDir, "extensions"), { withFileTypes: true })
        .filter((d) => d.isFile() && d.name.endsWith(".ts"))
        .map((d) => d.name.replace(/\.ts$/, ""))
        .sort()
    : [];

  const lines = [];
  lines.push("# PI");
  lines.push("");
  lines.push(`**Generated:** ${new Date().toISOString()}`);
  lines.push("");
  lines.push("Local inventory: unique skills from both repository roots, Pi single-file extensions, and configured packages. Includes locally installed private and licensed skill names.");
  lines.push("Rules for pi agents live in `.pi/agent/AGENTS.md`, not here — this file is inventory only.");
  lines.push("");
  lines.push(`## SKILLS (${skills.length})`);
  lines.push("");
  lines.push(skills.map((s) => `\`${s.name}\``).sort().join(", ") || "none");
  lines.push("");
  lines.push(`## EXTENSIONS (${extensions.length})`);
  lines.push("");
  lines.push(extensions.map((e) => `\`${e}\``).join(", ") || "none");
  lines.push("");
  lines.push(`## PACKAGES (${packages.length})`);
  lines.push("");
  for (const pkg of packages) lines.push(`- \`${pkg}\``);
  lines.push("");

  const outPath = path.join(PKG_ROOT, "pi", "PI.md");
  fs.writeFileSync(outPath, lines.join("\n"));
  console.log(`Wrote ${outPath}`);
}

async function loadRepositorySkills() {
  const npmRoot = execFileSync("npm", ["root", "-g"], { encoding: "utf8" }).trim();
  const loader = path.join(npmRoot, "@earendil-works", "pi-coding-agent", "dist", "core", "skills.js");
  const { loadSkills } = await import(pathToFileURL(loader).href);
  return loadSkills({
    cwd: REPO_ROOT,
    includeDefaults: false,
    skillPaths: [
      path.join(PKG_ROOT, "pi", ".pi", "agent", "skills"),
      path.join(PKG_ROOT, "agents", ".agents", "skills"),
    ],
  });
}

async function cmdSkillsCheck() {
  const roots = [
    path.join(PKG_ROOT, "pi", ".pi", "agent", "skills"),
    path.join(PKG_ROOT, "agents", ".agents", "skills"),
  ];
  const visited = new Set();
  const brokenLinks = [];
  function walk(dir) {
    const real = fs.realpathSync(dir);
    if (visited.has(real)) return;
    visited.add(real);
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      if (entry.name === "node_modules" || entry.name === ".git") continue;
      const file = path.join(dir, entry.name);
      if (entry.isSymbolicLink() && !fs.existsSync(file)) {
        brokenLinks.push(file);
      } else if (fs.statSync(file).isDirectory()) {
        walk(file);
      }
    }
  }
  for (const root of roots) walk(root);
  const result = await loadRepositorySkills();
  for (const file of brokenLinks) console.error(`Broken symlink: ${path.relative(REPO_ROOT, file)}`);
  for (const diagnostic of result.diagnostics) {
    console.error(`${diagnostic.type}: ${diagnostic.message} (${diagnostic.path})`);
    if (diagnostic.collision) {
      const { winnerPath, loserPath } = diagnostic.collision;
      const identical = fs.readFileSync(winnerPath).equals(fs.readFileSync(loserPath));
      console.error(`  ${identical ? "Identical copies" : "Divergent copies"}: ${winnerPath} / ${loserPath}`);
    }
  }
  const failures = brokenLinks.length + result.diagnostics.length;
  console.log(`${result.skills.length} unique repository skills; ${brokenLinks.length} broken symlinks; ${result.diagnostics.length} Pi diagnostics.`);
  process.exitCode = failures ? 1 : 0;
}

// --- entry -----------------------------------------------------------------
const [, , cmd, ...rest] = process.argv;

switch (cmd) {
  case "stow":
    cmdStow();
    break;
  case "unstow":
    cmdUnstow(rest[0]);
    break;
  case "alias":
    cmdAlias();
    break;
  case "doctor":
    cmdDoctor();
    break;
  case "benchmark-shell":
    cmdBenchmarkShell(rest);
    break;
  case "digest":
    cmdAgents();
    break;
  case "pi-digest":
    cmdPiDigest().catch((error) => {
      console.error(`Pi digest failed: ${error.message}`);
      process.exitCode = 1;
    });
    break;
  case "skills-check":
    cmdSkillsCheck().catch((error) => {
      console.error(`Skill check failed: ${error.message}`);
      process.exitCode = 1;
    });
    break;
  default:
    console.log("Usage: jdot <stow|unstow [pkg]|alias|doctor|benchmark-shell [-r N] [-v]|digest|pi-digest|skills-check>");
    process.exit(cmd ? 1 : 0);
}
