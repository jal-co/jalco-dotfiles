{
  "$schema": "https://opencode.ai/config.json",
  "theme": "vercel",
  "autoupdate": true,
  "plugin": [
    "opencode-antigravity-auth@1.2.8",
    "@tarquinen/opencode-dcp@latest",
    "opencode-anthropic-auth@0.0.9"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ylguoshepnwaiyisiygj",
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"]
    },
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "mcp-remote", "https://mcp.vercel.com"]
    },
    "grep_app": {
      "type": "local",
      "command": [
        "node",
        "/Users/justin/.config/opencode/mcp-servers/grep_app_mcp/dist/server-stdio.js"
      ]
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.2-codex",
      "description": "Heavy-duty coding and implementation"
    },
    "plan": {
      "model": "openai/gpt-5.2-codex-high",
      "description": "Architecture and planning"
    },
    "explore": {
      "model": "google/antigravity-gemini-3-flash",
      "mode": "primary",
      "description": "Quick exploration and research",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "frontend": {
      "model": "google/antigravity-gemini-3-pro-high",
      "mode": "subagent",
      "description": "UI/UX and frontend work"
    },
    "docs": {
      "model": "openai/gpt-5.1",
      "mode": "subagent",
      "description": "Documentation writing"
    },
    "vision": {
      "model": "google/antigravity-gemini-3-flash",
      "mode": "subagent",
      "description": "Image and PDF analysis"
    },
    "deep-think": {
      "model": "google/antigravity-claude-opus-4-5-thinking-high",
      "mode": "subagent",
      "description": "Complex reasoning and architecture decisions"
    },
    "visualization-expert-auditor": {
      "model": "anthropic/claude-opus-4-5",
      "mode": "subagent",
      "description": "reviews visualizations of data on dashboard to ensure proper graphs are being used",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude. You are Visualization Expert Auditor, an expert in data visualization and dashboard design. Your task is to review visualizations of data on dashboards to ensure that the most effective and appropriate graphs are being used to represent the data accurately and clearly. Provide feedback and suggestions for improvement where necessary. Focus on clarity, accuracy, and effectiveness of the visual representation."
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2-codex-high": {
