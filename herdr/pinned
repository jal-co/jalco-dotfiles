#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$HOME/coord"
readonly LABEL="pinned"
readonly COORD_NAME="coord"
readonly CONFIG="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/herdr-agents/config.json"

herdr_call() {
  if [[ -n "${HERDR_SESSION:-}" ]]; then
    herdr --session "$HERDR_SESSION" "$@"
  else
    herdr "$@"
  fi
}

coord_model() {
  [[ -f "$CONFIG" ]] || return 0
  python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as fh:
        config = json.load(fh)
except Exception:
    raise SystemExit(0)
print(config.get("models", {}).get("default", "") or "")
' "$CONFIG"
}

workspace_for_label() {
  python3 -c '
import json, sys
label = sys.argv[1]
for workspace in json.load(sys.stdin).get("result", {}).get("workspaces", []):
    if workspace.get("label") == label:
        print(workspace["workspace_id"])
        break
' "$1"
}

occupied_pane() {
  python3 -c '
import json, sys
workspace, panes_raw, agents_raw = sys.argv[1], sys.argv[2], sys.argv[3]
panes = [p["pane_id"] for p in json.loads(panes_raw)["result"]["panes"] if p.get("workspace_id") == workspace]
agent_panes = {a.get("pane_id") for a in json.loads(agents_raw)["result"]["agents"]}
for pane in panes:
    if pane in agent_panes:
        print(pane)
        break
' "$1" "$(herdr_call pane list)" "$(herdr_call agent list)"
}

any_pane() {
  python3 -c '
import json, sys
workspace = sys.argv[1]
for pane in json.load(sys.stdin)["result"]["panes"]:
    if pane.get("workspace_id") == workspace:
        print(pane["pane_id"])
        break
' "$1"
}

shell_ready() {
  local info
  info=$(herdr_call pane process-info --pane "$1" 2>/dev/null) || return 1
  python3 -c '
import json, sys
info = json.loads(sys.argv[1])["result"]["process_info"]
procs = info.get("foreground_processes") or []
sys.exit(0 if len(procs) == 1 and procs[0].get("pid") == info.get("shell_pid") else 1)
' "$info"
}

wait_for_shell() {
  local attempt
  for attempt in $(seq 1 24); do
    shell_ready "$1" && return 0
    sleep 0.5
  done
  return 1
}

split_pane() {
  local anchor
  anchor=$(any_pane "$1" <<<"$(herdr_call pane list)")
  herdr_call pane split --pane "$anchor" --direction right --cwd "$ROOT" --no-focus |
    python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])'
}

start_coordinator() {
  local pane=$1 name=${2:-$COORD_NAME} model attempt
  model=$(coord_model)
  local start_args=(--timeout 120000)
  [[ -n "$model" ]] && start_args+=(-- --model "$model")
  for attempt in $(seq 1 12); do
    if herdr_call agent start "$name" --kind pi --pane "$pane" "${start_args[@]}" >/dev/null 2>&1; then
      echo "coordinator $name ready on $pane"
      return 0
    fi
    wait_for_shell "$pane" || true
    sleep 1
  done
  echo "could not start the coordinator on $pane after 12 attempts" >&2
  return 1
}

free_name() {
  herdr_call agent list | python3 -c '
import json, sys
base = sys.argv[1]
taken = {a.get("name") for a in json.load(sys.stdin)["result"]["agents"]}
if base not in taken:
    print(base)
    raise SystemExit
for index in range(2, 10):
    candidate = f"{base}-{index}"
    if candidate not in taken:
        print(candidate)
        raise SystemExit
print(base)
' "$COORD_NAME"
}

if ! listing=$(herdr_call workspace list 2>/dev/null); then
  echo "herdr server is not running. Start herdr first, then rerun this." >&2
  exit 1
fi

fresh=false
case "${1:-}" in
  fresh|--fresh|new) fresh=true ;;
  "") ;;
  *)
    echo "usage: pinned [fresh]" >&2
    echo "  pinned        attach to the coordinator, starting one if nothing is running" >&2
    echo "  pinned fresh  start a second coordinator with a clean session beside the running one" >&2
    exit 2
    ;;
esac

mkdir -p "$ROOT"

workspace=$(workspace_for_label "$LABEL" <<<"$listing")

if [[ -n "$workspace" ]]; then
  if [[ "$fresh" == true ]]; then
    pane=$(split_pane "$workspace")
    if ! wait_for_shell "$pane"; then
      echo "pane $pane never reached a shell prompt" >&2
      exit 1
    fi
    name=$(free_name)
    start_coordinator "$pane" "$name"
    herdr_call workspace focus "$workspace" >/dev/null
    echo "fresh coordinator $name running in $workspace, pane $pane"
    exit 0
  fi
  running=$(occupied_pane "$workspace")
  if [[ -n "$running" ]]; then
    herdr_call workspace focus "$workspace" >/dev/null
    echo "pinned coordinator is up in $workspace, pane $running"
    exit 0
  fi
  pane=$(any_pane "$workspace" <<<"$(herdr_call pane list)")
  if [[ -z "$pane" ]]; then
    echo "no pane available in $workspace" >&2
    exit 1
  fi
  if ! wait_for_shell "$pane"; then
    pane=$(split_pane "$workspace")
    wait_for_shell "$pane" || {
      echo "pane $pane never reached a shell prompt" >&2
      exit 1
    }
  fi
  start_coordinator "$pane"
  herdr_call workspace focus "$workspace" >/dev/null
  echo "pinned coordinator restarted in $workspace, pane $pane"
  exit 0
fi

created=$(herdr_call workspace create --cwd "$ROOT" --label "$LABEL" --no-focus)
read -r workspace pane <<<"$(python3 -c '
import json, sys
result = json.load(sys.stdin)["result"]
print(result["workspace"]["workspace_id"], result["root_pane"]["pane_id"])
' <<<"$created")"

wait_for_shell "$pane" || {
  echo "pane $pane never reached a shell prompt" >&2
  exit 1
}
name=$(free_name)
start_coordinator "$pane" "$name"
herdr_call workspace focus "$workspace" >/dev/null

model=$(coord_model)
echo "pinned coordinator $name ready in $ROOT"
echo "workspace $workspace, pane $pane, model ${model:-inherited from pi}"
