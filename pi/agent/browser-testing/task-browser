#!/usr/bin/env node
import { spawnSync } from 'node:child_process'
import { lstatSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { homedir, tmpdir } from 'node:os'
import { join } from 'node:path'
import { readHeliumState } from './helium-cookies.mjs'
import { browserEnvironment, validateBatch, validateBrowserArgs, validateSession } from './policy.mjs'

const args = process.argv.slice(2)
const env = browserEnvironment()

function run(command, options = {}) {
  const result = spawnSync('agent-browser', command, { env, encoding: 'utf8', ...options })
  if (result.error) throw result.error
  if (result.status !== 0) throw new Error(result.stderr || `Agent Browser exited with ${result.status}`)
  return (result.stdout || '').trim()
}

function authTestLogin(loginUrl) {
  const configFile = join(homedir(), '.config', 'task-browser', 'mastra-test.json')
  let config
  try {
    const file = lstatSync(configFile)
    if (!file.isFile() || (file.mode & 0o077) || file.uid !== process.getuid()) throw new Error()
    config = JSON.parse(readFileSync(configFile, 'utf8'))
  } catch {
    throw new Error('Create a private ~/.config/task-browser/mastra-test.json owned by you with mode 600, environment TEST, itemReference and loginOrigin')
  }
  let request
  try {
    const url = new URL(loginUrl)
    const origin = new URL(config.loginOrigin)
    if (config.environment !== 'TEST' || typeof config.itemReference !== 'string' || !config.itemReference.trim() || config.itemReference.startsWith('-') ||
      url.protocol !== 'https:' || !/^[a-z0-9-]+\.authkit\.app$/.test(url.hostname) || url.port || url.username || url.password ||
      config.loginOrigin !== origin.origin || url.origin !== origin.origin) throw new Error()
    request = { loginUrl: url.href, itemReference: config.itemReference }
  } catch {
    throw new Error('TEST login requires a configured TEST account and a pinned HTTPS AuthKit origin matching the supplied URL')
  }
  try {
    const current = new URL(run(['get', 'url'], { timeout: 30000 }))
    if (current.origin !== new URL(request.loginUrl).origin || current.username || current.password) throw new Error()
  } catch {
    throw new Error('Open the configured WorkOS TEST login page in this task session before auth-test-login')
  }
  let username
  let password
  try {
    const result = spawnSync('op', ['item', 'get', request.itemReference, '--format=json'], { env, encoding: 'utf8', timeout: 30000 })
    if (result.error || result.status !== 0) throw new Error()
    const item = JSON.parse(result.stdout)
    username = item.fields.find(field => field.id === 'username')?.value
    password = item.fields.find(field => field.id === 'password')?.value
    if (item.category !== 'LOGIN' || typeof username !== 'string' || !username.trim() || username.startsWith('-') ||
      typeof password !== 'string' || !password || /[\r\n]/.test(password)) throw new Error()
  } catch {
    throw new Error('Could not read TEST login credentials; sign in to op and configure a dedicated password-only TEST Login item')
  }
  try {
    const origin = new URL(request.loginUrl).origin
    if (new URL(run(['get', 'url'], { timeout: 30000 })).origin !== origin) throw new Error()
    if (run(['get', 'count', 'input[type=password]'], { timeout: 30000 }) === '0') {
      run(['fill', 'input[type=email]', username], { timeout: 30000 })
      run(['press', 'Enter'], { timeout: 30000 })
    }
    run(['wait', 'input[type=password]'], { timeout: 30000 })
    const profile = `mastra-test-${env.AGENT_BROWSER_SESSION}`
    run(['auth', 'save', profile, '--url', origin, '--username', username, '--password-stdin'], { input: password, timeout: 30000 })
    try {
      run(['auth', 'login', profile, '--no-navigate', '--url', origin,
        '--username-selector', 'input[type=password]', '--password-selector', 'input[type=password]',
        '--submit-selector', 'input[type=password]'], { timeout: 30000 })
      run(['click', 'button[type=submit]'], { timeout: 30000 })
    } finally {
      run(['auth', 'delete', profile], { timeout: 30000 })
    }
  } catch {
    throw new Error('TEST login failed; check the trusted WorkOS email/password form; SSO, MFA and other forms are unsupported')
  }
  console.log('Submitted TEST account login in the isolated task session')
}

try {
  const command = args[0]
  if (command === 'session' && args[1] === 'id') {
    validateBrowserArgs(args)
    console.log(run(args))
    process.exit(0)
  }
  if (command === 'review') {
    if (args.length !== 2) throw new Error('Usage: task-browser review <http(s)-url>')
    const url = new URL(args[1])
    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
      throw new Error('Review requires an HTTP(S) URL without credentials')
    }
    if (process.platform !== 'darwin') throw new Error('Background review opening is only supported on macOS; share the URL instead')
    const result = spawnSync('/usr/bin/open', ['-g', url.href], { stdio: 'inherit' })
    if (result.error) throw result.error
    process.exit(result.status ?? 1)
  }
  const explicitSession = args.indexOf('--session')
  const session = validateSession((explicitSession >= 0 ? args[explicitSession + 1] : env.AGENT_BROWSER_SESSION) || run(['session', 'id', '--scope', 'worktree', '--prefix', 'task-ui']))
  env.AGENT_BROWSER_SESSION = session
  env.AGENT_BROWSER_RESTORE = session
  const artifacts = join(tmpdir(), 'agent-browser-artifacts', session)
  mkdirSync(artifacts, { recursive: true, mode: 0o700 })
  env.AGENT_BROWSER_SCREENSHOT_DIR ||= artifacts
  if (args.length === 1 && (command === 'session' || command === 'artifacts')) {
    console.log(command === 'session' ? session : artifacts)
    process.exit(0)
  }
  if (command === 'start') {
    if (args.length !== 2) throw new Error('Usage: task-browser start <url>')
    validateBrowserArgs(['open', args[1]])
    run(['open', args[1]], { stdio: 'inherit' })
    run(['set', 'viewport', '1440', '1000', '2'], { stdio: 'inherit' })
    run(['set', 'media', env.AGENT_BROWSER_COLOR_SCHEME || 'dark'], { stdio: 'inherit' })
    process.exit(0)
  }
  if (command === 'auth-test-login') {
    if (args.length !== 2) throw new Error('Usage: task-browser auth-test-login <hosted-login-url>')
    authTestLogin(args[1])
    process.exit(0)
  }
  if (command === 'auth-import-helium') {
    const state = readHeliumState(args.slice(1))
    if (!state.cookies.length) throw new Error(`Helium has no cookies for ${args.slice(1).join(', ')}`)
    const file = join(artifacts, `helium-state-${process.pid}.json`)
    writeFileSync(file, JSON.stringify(state), { mode: 0o600 })
    try {
      run(['state', 'load', file], { stdio: 'inherit' })
    } finally {
      rmSync(file, { force: true })
    }
    console.log(`Imported ${state.cookies.length} Helium cookies for ${args.slice(1).join(', ')}; reload the page`)
    process.exit(0)
  }
  if (command === 'ready') {
    run(['wait', '--load', 'networkidle'], { stdio: 'inherit' })
    run(['eval', '--stdin'], {
      input: `(async () => {
        await document.fonts.ready;
        await Promise.all(Array.from(document.images).filter(image => !image.complete).map(image => image.decode().catch(() => undefined)));
        return { url: location.href, title: document.title, width: innerWidth, height: innerHeight, devicePixelRatio };
      })()`,
      stdio: ['pipe', 'inherit', 'inherit'],
    })
    process.exit(0)
  }
  if (command === 'video-mp4') {
    if (!args[1] || args.length > 3) throw new Error('Usage: task-browser video-mp4 <input.webm> [output.mp4]')
    const output = args[2] || args[1].replace(/\.webm$/, '') + '.mp4'
    const result = spawnSync('ffmpeg', ['-y', '-i', args[1], '-an', '-c:v', 'libx264', '-preset', 'slow', '-crf', '18', '-pix_fmt', 'yuv420p', '-movflags', '+faststart', output], { stdio: 'inherit' })
    if (result.error) throw result.error
    process.exit(result.status ?? 1)
  }
  const action = validateBrowserArgs(args)
  let input
  if (action === 'batch') {
    const batchArgs = args.slice(args.indexOf('batch') + 1)
    const payloads = batchArgs.filter(arg => arg !== '--bail')
    input = validateBatch(payloads.length ? `[${payloads.join(',')}]` : readFileSync(0, 'utf8'))
    args.splice(args.indexOf('batch') + 1, batchArgs.length, ...(batchArgs.includes('--bail') ? ['--bail'] : []))
  }
  const result = spawnSync('agent-browser', args, {
    env,
    stdio: input === undefined ? 'inherit' : ['pipe', 'inherit', 'inherit'],
    input,
  })
  if (result.error) throw result.error
  process.exit(result.status ?? 1)
} catch (error) {
  console.error(error.message)
  process.exit(1)
}
