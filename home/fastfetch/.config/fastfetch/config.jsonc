{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "90"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "key": " ",
      "keyColor": "37",
      "color": {
        "1": "white"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "  os",
      "keyColor": "90"
    },
    {
      "type": "kernel",
      "key": "  kernel",
      "keyColor": "90"
    },
    {
      "type": "host",
      "format": "{5} {1}",
      "key": "  host",
      "keyColor": "90"
    },
    {
      "type": "shell",
      "key": "  shell",
      "keyColor": "90"
    },
    {
      "type": "terminal",
      "key": "  term",
      "keyColor": "90"
    },
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "  uptime",
      "keyColor": "90"
    },
    {
      "type": "memory",
      "key": "  memory",
      "keyColor": "90"
    },
    "break"
  ]
}
