.DS_Store

# NOTE: this file lives in home/pi/, so patterns are relative to home/pi/.
# The package tree is .pi/ — do NOT add a blanket `/.pi/` rule here or it
# will ignore the entire package. Use the granular rules below.

# Secrets & auth
.pi/agent/auth.json

# MCP caches (regenerated at runtime)
.pi/agent/mcp-cache.json
.pi/agent/mcp-npx-cache.json

# Sessions (ephemeral, large)
.pi/agent/sessions/

# Binaries (pi recreates these on install)
.pi/agent/bin/
.pi/agent/jars/

# Node modules (reinstall via npm/bun install)
.pi/agent/extensions/node_modules/
.pi/agent/extensions/*/node_modules/
.pi/agent/skills/*/node_modules/

# Build artifacts
.pi/agent/extensions/*/dist/

# MCPorter compiled binaries (regenerate with /mcporter prompt)
.pi/agent/skills/exa/exa

# Personal/private skills (contain PII, voice samples, or account-specific data)
.pi/agent/skills/write-like-justin/
.pi/agent/skills/job-search/
.pi/agent/skills/real-app/

# Personal prompts (contain resume details, contact info)
.pi/agent/prompts/jobs.md

# Update cache (runtime state)
.pi/agent/update-cache.json

# Runtime state (regenerated by pi)
.pi/agent/cursor-sdk*.json
.pi/agent/models-store.json
.pi/agent/mcp-onboarding.json
.pi/agent/pi-codex-conversion.json
.pi/agent/run-history.jsonl
.pi/agent/settings.json.bak
.pi/agent/trust.json
.pi/agent/mcp-oauth/
.pi/agent/git/
.pi/agent/npm/
.pi/cache/
.pi/context-mode/

# Personal time tracking data
.pi/agent/time-tracking.json
.pi/agent/time-clients.json

# Codex Micro runtime state
.pi/agent/codex-micro-slots/
.pi/agent/codex-micro.json
.pi/agent/settings.json.codex-micro-backup
.pi/agent/microd.log

# Compiled helper binaries (time-tracker deps, rebuild locally)
.pi/agent/fnkey
.pi/agent/frontapp
.pi/agent/keysend

# Parked skills
.pi/agent/skills-disabled/

# Browser-tools scratch scripts
.pi/agent/skills/browser-tools/_*.mjs
.pi/agent/skills/browser-tools/capture-badges.mjs

# Local package node_modules
.pi/agent/packages/*/node_modules/
