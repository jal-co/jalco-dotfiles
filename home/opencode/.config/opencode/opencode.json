{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "anthropic/claude-haiku-4-5",
  "share": "manual",
  "autoupdate": false,
  "instructions": ["~/.pi/agent/AGENTS.md"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": { "context": 500000, "output": 128000 },
          "options": { "reasoningEffort": "medium" }
        },
        "gpt-5.6-terra": {
          "limit": { "context": 272000, "output": 128000 },
          "options": { "reasoningEffort": "medium" }
        },
        "gpt-5.6-luna": {
          "limit": { "context": 272000, "output": 128000 }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": { "context": 272000, "output": 128000 },
          "cost": { "input": 10, "output": 50, "cache_read": 1, "cache_write": 0 },
          "options": { "reasoningEffort": "medium" }
        }
      }
    },
    "anthropic": {
      "models": {
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1",
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 10, "output": 50, "cache_read": 0.25, "cache_write": 12.5 }
        },
        "claude-opus-5": {
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-4-8": {
          "limit": { "context": 1000000, "output": 128000 }
        }
      }
    },
    "crof": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CrofAI",
      "options": {
        "baseURL": "https://crof.ai/v1",
        "apiKey": "{env:CROFAI_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 0.35, "output": 0.8, "cache_read": 0.003, "cache_write": 0 } },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 0.12, "output": 0.21, "cache_read": 0.003, "cache_write": 0 } },
        "deepseek-v3.2": { "name": "DeepSeek V3.2", "limit": { "context": 163840, "output": 163840 }, "cost": { "input": 0.18, "output": 0.35, "cache_read": 0.04, "cache_write": 0 } },
        "kimi-k3": { "name": "Kimi K3", "limit": { "context": 1000000, "output": 262144 }, "cost": { "input": 2, "output": 8, "cache_read": 0.25, "cache_write": 0 } },
        "kimi-k3-eco": { "name": "Kimi K3 (Eco)", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 1, "output": 4, "cache_read": 0.1, "cache_write": 0 } },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code", "limit": { "context": 262144, "output": 262144 }, "cost": { "input": 0.55, "output": 2.25, "cache_read": 0.05, "cache_write": 0 } },
        "glm-5.3-flash": { "name": "GLM 5.3 Flash", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 0.07, "output": 0.22, "cache_read": 0.01, "cache_write": 0 } },
        "glm-5.2": { "name": "GLM 5.2", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 0.3, "output": 1.05, "cache_read": 0.05, "cache_write": 0 } },
        "mimo-v2.5-pro": { "name": "MiMo V2.5 Pro", "limit": { "context": 1000000, "output": 131072 }, "cost": { "input": 0.4, "output": 0.8, "cache_read": 0.003, "cache_write": 0 } },
        "gemma-4-31b-it": { "name": "Gemma 4 31B", "limit": { "context": 262144, "output": 262144 }, "cost": { "input": 0.1, "output": 0.3, "cache_read": 0.02, "cache_write": 0 } },
        "qwen3.8-27b": { "name": "Qwen3.8 27B", "limit": { "context": 262144, "output": 262144 }, "cost": { "input": 0.2, "output": 1.5, "cache_read": 0.03, "cache_write": 0 } },
        "qwen3.5-397b-a17b": { "name": "Qwen3.5 397B A17B", "limit": { "context": 262144, "output": 262144 }, "cost": { "input": 0.35, "output": 1.75, "cache_read": 0.07, "cache_write": 0 } }
      }
    },
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "minimaxai/minimax-m2.7": { "name": "MiniMax M2.7", "limit": { "context": 128000, "output": 8192 } }
      }
    }
  },
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["/opt/homebrew/bin/uvx", "--python", "3.11", "blender-mcp"],
      "environment": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      },
      "enabled": false
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "environment": { "EXA_API_KEY": "{env:EXA_API_KEY}" }
    },
    "natural": { "type": "remote", "url": "https://mcp.natural.com" },
    "granola": { "type": "remote", "url": "https://mcp.granola.ai/mcp" },
    "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
    "posthog": { "type": "remote", "url": "https://mcp.posthog.com/mcp" },
    "posthog-flags": { "type": "remote", "url": "https://mcp.posthog.com/mcp?features=flags", "enabled": false },
    "posthog-read": { "type": "remote", "url": "https://mcp.posthog.com/mcp?readonly=true", "enabled": false },
    "notion": { "type": "remote", "url": "https://mcp.notion.com/mcp" },
    "typefully": {
      "type": "remote",
      "url": "https://mcp.typefully.com/mcp?TYPEFULLY_API_KEY={env:TYPEFULLY_API_KEY}",
      "oauth": false
    },
    "paper": { "type": "remote", "url": "http://127.0.0.1:29979/mcp", "oauth": false }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "npm publish*": "ask",
      "rm -rf*": "ask",
      "rm -fr*": "ask",
      "sudo *": "ask",
      "chmod 777*": "deny",
      "chmod -R 777*": "deny"
    },
    "skill": "allow"
  }
}
