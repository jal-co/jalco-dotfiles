.DS_Store
__MACOSX/
.AppleDouble
.LSOverride
Icon[]

# Node.js
node_modules/
package.json
bun.lock
pnpm-lock.yaml
package-lock.json
yarn.lock

# jdot: machine-local package opt-outs
.jdotignore

# tmux: TPM-managed plugins, reinstall via prefix + I
