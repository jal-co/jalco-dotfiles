.DS_Store

# Secrets & auth
pi/.pi/agent/auth.json

# MCP caches (regenerated at runtime)
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/mcp-npx-cache.json

# Sessions (ephemeral, large)
pi/.pi/agent/sessions/

# Binaries (pi recreates these on install)
pi/.pi/agent/bin/
pi/.pi/agent/jars/

# Node modules (reinstall via npm/bun install)
pi/.pi/agent/extensions/node_modules/
pi/.pi/agent/extensions/*/node_modules/
pi/.pi/agent/skills/*/node_modules/

# Build artifacts
pi/.pi/agent/extensions/*/dist/

# MCPorter compiled binaries (regenerate with /mcporter prompt)
pi/.pi/agent/skills/exa/exa

# Personal/private skills (contain PII, voice samples, or account-specific data)
pi/.pi/agent/skills/write-like-justin/
pi/.pi/agent/skills/job-search/
pi/.pi/agent/skills/real-app/

# Personal prompts (contain resume details, contact info)
pi/.pi/agent/prompts/jobs.md

# Update cache (runtime state)
pi/.pi/agent/update-cache.json

# Local pi folder (root level only, not tracked stow files)
/.pi/
# Runtime state (regenerated by pi)
pi/.pi/agent/cursor-sdk*.json
pi/.pi/agent/models-store.json
pi/.pi/agent/mcp-onboarding.json
pi/.pi/agent/pi-codex-conversion.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/settings.json.bak
pi/.pi/agent/trust.json
pi/.pi/agent/mcp-oauth/
pi/.pi/agent/git/
pi/.pi/agent/npm/
pi/.pi/cache/
pi/.pi/context-mode/

# Personal time tracking data
pi/.pi/agent/time-tracking.json
pi/.pi/agent/time-clients.json

# Codex Micro runtime state
pi/.pi/agent/codex-micro-slots/
pi/.pi/agent/codex-micro.json
pi/.pi/agent/settings.json.codex-micro-backup
pi/.pi/agent/microd.log

# Compiled helper binaries (time-tracker deps, rebuild locally)
pi/.pi/agent/fnkey
pi/.pi/agent/frontapp
pi/.pi/agent/keysend

# Parked skills
pi/.pi/agent/skills-disabled/

# Browser-tools scratch scripts
pi/.pi/agent/skills/browser-tools/_*.mjs
pi/.pi/agent/skills/browser-tools/capture-badges.mjs

# Local package node_modules
pi/.pi/agent/packages/*/node_modules/
