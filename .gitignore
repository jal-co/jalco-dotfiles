# Environment files
.env
.env.local
.env.*.local
AGENTS.md

###############################################
#                    pi
###############################################

# Secrets & auth
home/pi/.pi/agent/auth.json

# MCP caches (regenerated at runtime)
home/pi/.pi/agent/mcp-cache.json
home/pi/.pi/agent/mcp-npx-cache.json

# Sessions (ephemeral, large)
home/pi/.pi/agent/sessions/

# Binaries (pi recreates these on install)
home/pi/.pi/agent/bin/
home/pi/.pi/agent/jars/

# Node modules (reinstall via npm/bun install)
home/pi/.pi/agent/extensions/node_modules/
home/pi/.pi/agent/extensions/*/node_modules/
home/pi/.pi/agent/skills/*/node_modules/
home/pi/.pi/agent/packages/*/node_modules/

# Build artifacts
home/pi/.pi/agent/extensions/*/dist/

# MCPorter compiled binaries
home/pi/.pi/agent/skills/exa/exa

# Personal/private skills (PII, voice samples, account-specific data)
home/pi/.pi/agent/skills/write-like-justin/
home/pi/.pi/agent/skills/job-search/
home/pi/.pi/agent/skills/real-app/

# Personal prompts (resume details, contact info)
home/pi/.pi/agent/prompts/jobs.md

# Runtime state (regenerated by pi)
home/pi/.pi/agent/update-cache.json
home/pi/.pi/agent/cursor-sdk*.json
