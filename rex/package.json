{
  "name": "pi-rex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rex-native fork of pi-herdr-agents with persistent task recovery, PR merge notifications and retained Pi history",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "rex",
    "subagents"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs task-runtime/test/*.test.mjs",
    "test:live": "node task-runtime/test/live.mjs",
    "task-runtime": "node task-runtime/src/cli.mjs",
    "mcp": "node task-runtime/src/mcp.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/",
    "host/",
    "config/modules.json"
  ],
  "engines": {
    "node": ">=24.2"
  }
}
