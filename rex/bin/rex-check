if [ "$#" -eq 0 ]; then
  printf 'Usage: rex-check COMMAND [ARG...]\n' >&2
  exit 2
fi
if [ "$(systemctl --user show app-rexchecks.slice --property=CPUQuotaPerSecUSec --value)" != 8s ]; then
  printf 'rex-check requires the installed app-rexchecks.slice with CPUQuota=800%%.\n' >&2
  exit 1
fi
exec systemd-run --user --scope --quiet --slice=app-rexchecks.slice --expand-environment=no nice -n 10 "$@"
